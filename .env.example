# Copy this file to .env and fill in your real Supabase project values.
# Never commit the real .env file (it's already in .gitignore).

# Pooled connection (via Supabase's connection pooler / pgbouncer, port 6543).
# Used by the app at runtime — see src/lib/prisma.ts.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (bypasses the pooler, port 5432).
# Used only by Prisma CLI commands (migrate, db push, studio) — see prisma7.config.ts.
# Required because DDL statements (creating/altering tables) are not reliable through pgbouncer.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Spoonacular recipe API key (free tier, ~150 points/day) — https://spoonacular.com/food-api/console
# Server-only: used by src/lib/recipes/spoonacular.ts for the /recipes swipe deck.
SPOONACULAR_API_KEY=""

# Passcode gate (src/proxy.ts + src/lib/auth.ts). APP_PASSWORD is the passcode: 4–8 digits. Without APP_PASSWORD the gate is off in
# development and everything is locked in production. AUTH_SECRET signs the session cookie
# (any long random string, e.g. `openssl rand -base64 32`); changing it logs every device out.
APP_PASSWORD=""
AUTH_SECRET=""

# Look: leave empty for the green sheep; "cat" = pink with a cat (for a second copy of the app). Build-time.
NEXT_PUBLIC_THEME=""

# Push notifications (src/lib/push/). Generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Bearer token the scheduler (.github/workflows/push-cron.yml) sends to /api/push/cron.
CRON_SECRET=""

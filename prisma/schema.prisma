// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Connection URLs are configured in prisma7.config.ts, not here (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Recurring/monthly budget cycles ("cycles") ---
// One row per day within a period, tracking theoretical (planned decay from
// startingBudget) vs actual balances.

model BudgetCycle {
  id             String           @id @default(cuid())
  name           String
  startingBudget Decimal          @db.Decimal(12, 2)
  startDate      DateTime         @db.Date
  endDate        DateTime         @db.Date

  // Month-level money snapshot, edited by hand. Used to estimate whether
  // spending puts the balance at risk (available after rent, safe spend/day).
  bank              Decimal   @default(0) @db.Decimal(12, 2)
  tricount          Decimal   @default(0) @db.Decimal(12, 2)
  cash              Decimal   @default(0) @db.Decimal(12, 2)
  balancesUpdatedAt DateTime?
  rent              Decimal   @default(0) @db.Decimal(12, 2)
  rentDay           Int?

  // Groups periods with the same kind of life ("Thuis", "Galway") so Insights
  // can compare a period with the average of its peers.
  label             String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  days           BudgetCycleDay[]
  expenses       Expense[]

  @@index([startDate])
}

model BudgetCycleDay {
  id      String      @id @default(cuid())
  cycleId String
  cycle   BudgetCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  date    DateTime    @db.Date

  // Plan-time values, known for the whole cycle range up front.
  theoreticalBalance Decimal @db.Decimal(12, 2)
  dailyGoal          Decimal @db.Decimal(12, 2)

  // Actuals, only known once a day has been logged — nullable so unlogged
  // days render as real gaps in the chart instead of fake zeros.
  cashBalance  Decimal? @db.Decimal(12, 2)
  bankBalance  Decimal? @db.Decimal(12, 2)
  totalBalance Decimal? @db.Decimal(12, 2)
  amountSpent  Decimal? @db.Decimal(12, 2)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, date])
  @@index([cycleId, date])
}

// --- Trips: a separate, dated budget alongside the monthly ones ---
// Expenses use the same global categories as months.

model Trip {
  id          String     @id @default(cuid())
  name        String
  totalBudget Decimal    @db.Decimal(12, 2)
  startDate   DateTime   @db.Date
  endDate     DateTime   @db.Date
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  expenses    Expense[]

  @@index([startDate])
}

// One global list shared by every month and trip. Managed from the expenses
// screen. "color" is a palette slot key (see src/lib/categoryPalette.ts), not a
// raw hex, so light/dark values resolve through the --color-tag-* theme tokens.
// A category with a pintPrice counts as beer in the insights.
model Category {
  id         String    @id @default(cuid())
  name       String    @unique
  color      String    @default("blue")
  sortOrder  Int       @default(0)
  isArchived Boolean   @default(false)
  pintPrice  Decimal?  @db.Decimal(6, 2)
  createdAt  DateTime  @default(now())
  expenses   Expense[]

  @@index([isArchived, sortOrder])
}

// Belongs to exactly one period: a month (cycleId) or a trip (tripId), enforced
// in the mutation layer (src/lib/actions/expenses.ts).
model Expense {
  id         String       @id @default(cuid())
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cycleId    String?
  cycle      BudgetCycle? @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  date       DateTime     @db.Date
  amount     Decimal      @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime     @default(now())

  @@index([categoryId, date])
  @@index([tripId, date])
  @@index([cycleId, date])
}

// --- Savings / net-worth log ---
// Flat timestamped list, not scoped to any cycle/trip.

model SavingsEntry {
  id                String   @id @default(cuid())
  transactionNumber Int
  runningTotal      Decimal  @db.Decimal(12, 2)
  bonusAmount       Decimal? @db.Decimal(12, 2)
  date              DateTime
  createdAt         DateTime @default(now())

  @@index([date])
}

// --- Debts ("Schulden") ---
// Simple running list. Signed amount: positive = owed to the user,
// negative = the user owes them.

model Debt {
  id        String   @id @default(cuid())
  name      String
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Waypoint: road-trip journal (merged in from the standalone Waypoint app) ---
// Unrelated to the budget Trip above. UUID ids are kept from the old Supabase
// project so trip URLs survive the move. App code reads these through
// src/lib/waypoint/rows.ts, which maps them to the snake_case types the
// Waypoint components use.

model WaypointTrip {
  id              String             @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  startDate       DateTime?          @db.Date
  endDate         DateTime?          @db.Date
  coverImage      String?
  totalKm         Decimal?           @db.Decimal(10, 2)
  // "allow_tolls" | "avoid_tolls" — stored but ignored by the public OSRM server.
  routePreference String             @default("allow_tolls")
  // Whole-trip OSRM route as a GeoJSON LineString.
  routeGeometry   Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  locations       WaypointLocation[]

  @@index([startDate])
}

model WaypointLocation {
  id            String       @id @default(uuid()) @db.Uuid
  tripId        String       @db.Uuid
  trip          WaypointTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name          String
  latitude      Decimal      @db.Decimal(10, 7)
  longitude     Decimal      @db.Decimal(10, 7)
  country       String?
  city          String?
  arrivalDate   DateTime?    @db.Date
  departureDate DateTime?    @db.Date
  notes         String?
  visitOrder    Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tripId, visitOrder])
}

// --- Recipes: liked recipes from the swipe deck ---
// A snapshot of the Spoonacular recipe is stored so the saved list and the
// detail view cost no API quota and keep working when the daily quota is gone.

model SavedRecipe {
  id             String    @id @default(cuid())
  spoonacularId  Int       @unique
  title          String
  image          String?
  readyInMinutes Int?
  servings       Int?
  cuisines       String[]
  dishTypes      String[]
  sourceUrl      String?
  summary        String?
  // RecipeIngredient[] and string[] (see src/lib/recipes/types.ts).
  ingredients    Json
  steps          Json
  likedAt        DateTime  @default(now())
  // null = still to make.
  madeOn         DateTime? @db.Date
  createdAt      DateTime  @default(now())

  @@index([madeOn, likedAt])
}

// What's in the fridge/cupboard, for the "what can I make" search on /recipes/fridge.
model PantryItem {
  id        String   @id @default(cuid())
  // Trimmed and lowercased.
  name      String   @unique
  createdAt DateTime @default(now())
}
